# OpenAI-compatible provider. DeepSeek is the default example.
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-chat

MAX_STEPS=12
TEST_TIMEOUT_SECONDS=45
MAX_TOOL_OUTPUT_CHARS=6000
VERIFY_ALL_TESTS=true

# Optional: current provider prices per one million tokens. Zero disables cost estimation.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
