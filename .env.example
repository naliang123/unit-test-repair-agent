# OpenAI-compatible provider. DeepSeek is the default example.
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-chat

MAX_STEPS=12
TEST_TIMEOUT_SECONDS=45
MAX_TOOL_OUTPUT_CHARS=6000
VERIFY_ALL_TESTS=true
APPROVE_EDITS=false

# Optional: MCP tool servers (JSON array). See repair_agent/mcp.py for the schema.
# stdio command must point to a Python that has `mcp` installed, e.g. the project venv:
#   [{"name":"memory","command":"C:\\path\\to\\.venv\\Scripts\\python.exe","args":["-m","examples.demo_mcp_server"]}]
# sse example: [{"name":"remote","transport":"sse","url":"http://127.0.0.1:8765/sse"}]
MCP_SERVERS=

# Optional: current provider prices per one million tokens. Zero disables cost estimation.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
